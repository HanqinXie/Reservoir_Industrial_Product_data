<script>
portal.showNav(1);
$(function(){
	$('#searchBtn').bind('click', doSearch);
	$('#keyword').bind('keyup',function(e){
		if(e.keyCode=='13')
			doSearch();
	});
});
function doSearch(){
	var key=$('#keyword').val();
	location.href='/stdList?key='+key+(searchBox.ministry?'&ministry='+searchBox.ministry:'')+(searchBox.trade?'&trade='+searchBox.trade:'')+(searchBox.pubTime?'&pubtime='+searchBox.pubTime:'');
}
var searchBox={ministry:'', trade:'', pubTime:''};

//滚动
var rollspeed = 30;
rolllinkk2.innerHTML = rolllinkk1.innerHTML; 
function Marquee1() {
    if (rolllinkk2.offsetTop - rolllinkk.scrollTop <= 0){
        rolllinkk.scrollTop -= rolllinkk1.offsetHeight; 
    }else {
        rolllinkk.scrollTop++;
    }
}

var MyMar1 = setInterval(Marquee1, rollspeed); //
rolllinkk.onmouseover = function () {
    clearInterval(MyMar1);
}
rolllinkk.onmouseout = function () {
    MyMar1 = setInterval(Marquee1, rollspeed);
}
</script>